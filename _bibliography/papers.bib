doi = {10.1145/1160633.1160645},
abstract = {Aiming to represent individuals in a very realistic way, several works have attempted to introduce personality characteristics into artificial agents, usually based on theories of human personality. However, different theories require different structures in the agent architecture, reflecting on the way they influence agent behavior. This paper presents a flexible framework to generalize the influence of personality traits on the behavior of the agents. The framework provides an easy way to test and compare different personality models. In order to validate the framework, a simulation of working environment was developed and three personality theories (Big Five, Jung and Millon) were tested.},
booktitle = {Proceedings of the Fifth International Joint Conference on Autonomous Agents and Multiagent Systems},
pages = {97–104},
numpages = {8},
keywords = {personality-based agents, agent-based framework, agent architecture},
location = {Hakodate, Japan},
series = {AAMAS '06}
}

